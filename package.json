{
  "name": "focoaprova-desktop",
  "productName": "FocoAprova",
  "version": "0.1.0",
  "description": "Pílula de estudo do FocoAprova que fica sempre no topo da tela do Windows",
  "author": "Paulo Levy Soares e Sá",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.focoaprova.desktop",
    "productName": "FocoAprova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/tray.png",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FocoAprova"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
